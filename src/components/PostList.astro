---
import { formatMonth, postUrl, type Post } from '../lib/posts';
interface Props { posts: Post[]; heading?: string }
const { posts, heading = 'Writing' } = Astro.props;
---
<section>
  <h2>{heading}</h2>
  {posts.length === 0 ? (
    <p class="muted">還沒有文章。</p>
  ) : (
    <ul>
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatMonth(post.data.date)}</time>
          <a href={postUrl(post)}>{post.title}</a>
        </li>
      ))}
    </ul>
  )}
</section>
<style>
  h2 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; gap: 1.25rem; padding: 0.35rem 0; }
  time { flex: none; color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.92rem; padding-top: 0.08rem; }
  a { color: var(--fg); text-decoration: none; }
  a:hover { color: var(--accent); text-decoration: underline; }
</style>
