---
import { SITE } from '../site.config';
---
<header>
  <a class="name" href="/">{SITE.name}</a>
  <nav>
    {SITE.links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</header>
<style>
  header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; margin-bottom: 3rem; }
  .name { font-weight: 700; font-size: 1.15rem; color: var(--fg); text-decoration: none; }
  nav { display: flex; gap: 1.1rem; font-size: 0.95rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--accent); }
</style>
